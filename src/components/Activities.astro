---
const { activities } = Astro.props
---

<section id="activities" class="section" aria-labelledby="act-heading">
  <p class="section-label" id="act-heading">Activities</p>

  <div class="space-y-4">
    {activities.map((act: {
      title: string
      type: string
      description: string
      items: string[]
      link: string
    }) => (
      <article class="card p-5 group">
        <!-- Header -->
        <div class="flex items-start justify-between gap-4 mb-3">
          <div>
            <div class="flex items-center gap-2 mb-1">
              {act.link !== '#' ? (
                <a
                  href={act.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ext-link text-sm font-semibold"
                  style="color:#ccd6f6;"
                >
                  {act.title}
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              ) : (
                <h3 class="text-sm font-semibold" style="color:#ccd6f6;">{act.title}</h3>
              )}
            </div>
            <span class="tag text-xs">{act.type}</span>
          </div>
        </div>

        <!-- Description -->
        <p class="text-sm leading-relaxed mb-3" style="color:#8892b0;">{act.description}</p>

        <!-- Items -->
        <ul class="space-y-1.5">
          {act.items.map((item: string) => (
            <li class="flex items-start gap-2 text-xs leading-relaxed" style="color:#8892b0;">
              <span class="flex-shrink-0 mt-0.5" style="color:#64ffda;">▹</span>
              {item}
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
