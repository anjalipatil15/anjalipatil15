---
const { certifications } = Astro.props
---

<section id="certifications" class="section" aria-labelledby="certs-heading">
  <p class="section-label" id="certs-heading">Certifications</p>

  <div class="space-y-3">
    {certifications.map((cert: { name: string; issuer: string; focus: string; image?: string }) => (
      <div class="cert-card group">

        <!-- Image -->
        <div class="cert-thumb">
          {cert.image ? (
            <img
              src={cert.image}
              alt={cert.name}
              width="56"
              height="56"
              loading="lazy"
              class="w-full h-full object-contain rounded"
            />
          ) : (
            <div class="w-full h-full rounded flex items-center justify-center"
              style="background:rgba(100,255,218,0.05); border:1px solid rgba(100,255,218,0.1);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#64ffda" stroke-width="1.5" opacity="0.5">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
          )}
        </div>

        <!-- Text -->
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium transition-colors group-hover:text-teal" style="color:#ccd6f6;">
            {cert.name}
          </p>
          <p class="font-mono text-xs mt-0.5" style="color:#64ffda; opacity:0.55;">{cert.issuer}</p>
          <p class="text-xs mt-1.5 leading-relaxed" style="color:#8892b0;">{cert.focus}</p>
        </div>

      </div>
    ))}
  </div>
</section>

<style>
  .cert-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 16px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    transition: all 0.25s ease;
  }
  .cert-card:hover {
    background: #1e293b;
    border-color: rgba(100,255,218,0.1);
    box-shadow: 0 4px 20px rgba(2,12,27,0.4);
    transform: translateY(-1px);
  }

  .cert-thumb {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 6px;
    overflow: hidden;
  }
</style>