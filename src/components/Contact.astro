---
const { personal } = Astro.props
---

<section id="contact" class="section" aria-labelledby="contact-heading">
  <p class="section-label" id="contact-heading">Contact</p>

  <div class="mb-8 max-w-md">
    <p class="text-sm leading-relaxed mb-3" style="color:#a8b2d8;">
      Open to internships, research collaborations, and conversations about
      cybersecurity, ML, and building interesting things.
    </p>
    <p class="text-sm leading-relaxed" style="color:#8892b0;">
      The best way to reach me is by email. I'm also on LinkedIn and post
      technical write-ups on Medium.
    </p>
  </div>

  <!-- Primary CTA -->
  <a
    href={`mailto:${personal.email}`}
    class="inline-flex items-center gap-2.5 font-mono text-sm font-medium px-6 py-3 rounded border transition-all duration-200 mb-8"
    style="border-color:#64ffda; color:#64ffda;"
    onmouseover="this.style.background='rgba(100,255,218,0.08)'"
    onmouseout="this.style.background='transparent'"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
    Say Hello
  </a>

  <!-- Other channels -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    {[
      { label: 'GitHub',   href: personal.github,   desc: 'Source & projects' },
      { label: 'LinkedIn', href: personal.linkedin,  desc: 'Professional profile' },
      { label: 'Medium',   href: personal.medium,    desc: 'Writing & notes' },
    ].map(ch => (
      <a
        href={ch.href}
        target="_blank"
        rel="noopener noreferrer"
        class="card p-4 block group"
      >
        <p class="text-sm font-medium mb-1 group-hover:text-teal transition-colors" style="color:#ccd6f6;">{ch.label}</p>
        <p class="text-xs" style="color:#8892b0;">{ch.desc}</p>
        <p class="font-mono text-xs mt-2 group-hover:text-teal transition-colors" style="color:#64ffda; opacity:0.5;">↗ Visit</p>
      </a>
    ))}
  </div>
</section>
