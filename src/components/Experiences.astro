---
import SectionHeader from './SectionHeader.astro'
const { experiences } = Astro.props
---

<section id="experiences" class="section" aria-labelledby="experiences-heading">
  <div class="max-w-5xl mx-auto px-6">
    <SectionHeader label="Work & Leadership" heading="Experience" />

    <div class="timeline-track pl-8 space-y-6">
      {experiences.map((exp: {
        role: string
        organization: string
        period: string
        description: string
        points: string[]
      }) => (
        <div class="relative">
          <!-- Timeline dot -->
          <div
            class="absolute -left-8 top-[22px]"
            aria-hidden="true"
          >
            <div style="width:14px;height:14px;border-radius:50%;border:2px solid #0e7490;background:#080b10;"></div>
          </div>

          <article class="ap-card p-5">
            <!-- Role + period -->
            <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
              <div>
                <h3 class="font-display font-bold text-slate-100 text-base">{exp.role}</h3>
                <p class="font-mono text-[12px] text-cyan-700 mt-0.5">{exp.organization}</p>
              </div>
              <span class="font-mono text-[11px] text-slate-500 flex-shrink-0 mt-0.5">{exp.period}</span>
            </div>

            <!-- Description -->
            <p class="text-slate-400 text-[13px] leading-relaxed mt-3 mb-3">{exp.description}</p>

            <!-- Points -->
            <ul class="space-y-1.5">
              {exp.points.map((point: string) => (
                <li class="flex items-start gap-2 text-[13px] text-slate-500">
                  <span class="text-cyan-700 mt-0.5 flex-shrink-0">›</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>
