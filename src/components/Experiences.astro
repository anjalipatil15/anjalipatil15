---
const { experiences } = Astro.props
---

<section id="experiences" class="section" aria-labelledby="exp-heading">
  <p class="section-label" id="exp-heading">Experience</p>

  <div class="space-y-2">
    {experiences.map((exp: {
      role: string
      organization: string
      period: string
      description: string
      points: string[]
    }, i: number) => (
      <article class="card p-5 group">
        <!-- Period -->
        <p class="font-mono text-xs mb-3 tracking-widest" style="color:#64ffda; opacity:0.55;">
          {exp.period}
        </p>

        <!-- Role + org -->
        <div class="flex flex-wrap items-baseline gap-x-2 mb-3">
          <h3 class="text-sm font-semibold group-hover:text-teal transition-colors" style="color:#ccd6f6;">
            {exp.role}
          </h3>
          <span class="text-sm" style="color:#64ffda; opacity:0.7;">·</span>
          <span class="text-sm" style="color:#8892b0;">{exp.organization}</span>
        </div>

        <!-- Description -->
        <p class="text-sm leading-relaxed mb-3" style="color:#8892b0;">{exp.description}</p>

        <!-- Points -->
        <ul class="space-y-1.5">
          {exp.points.map((pt: string) => (
            <li class="flex items-start gap-2 text-xs leading-relaxed" style="color:#8892b0;">
              <span class="flex-shrink-0 mt-0.5" style="color:#64ffda;">▹</span>
              {pt}
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
