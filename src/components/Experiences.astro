---
const { experiences } = Astro.props
---

<section id="experiences" class="section" aria-labelledby="exp-heading">
  <p class="section-label" id="exp-heading">Experience</p>

  <div class="space-y-3">
    {experiences.map((exp: {
      role: string
      organization: string
      period: string
      description: string
      points: string[]
    }) => (
      <article class="exp-card group">

        <!-- Period -->
        <p class="font-mono text-xs mb-3 tracking-widest" style="color:#64ffda; opacity:0.5;">
          {exp.period}
        </p>

        <!-- Role + org -->
        <div class="flex flex-wrap items-baseline gap-x-2 mb-2">
          <h3 class="text-sm font-semibold transition-colors group-hover:text-teal" style="color:#ccd6f6;">
            {exp.role}
          </h3>
          <span style="color:#64ffda; opacity:0.5;">·</span>
          <span class="text-sm" style="color:#8892b0;">{exp.organization}</span>
        </div>

        <!-- Description -->
        <p class="text-sm leading-relaxed mb-3" style="color:#8892b0;">{exp.description}</p>

        <!-- Points -->
        <ul class="space-y-1.5">
          {exp.points.map((pt: string) => (
            <li class="flex items-start gap-2 text-xs leading-relaxed" style="color:#8892b0;">
              <span class="flex-shrink-0 mt-0.5" style="color:#64ffda;">▹</span>
              {pt}
            </li>
          ))}
        </ul>

      </article>
    ))}
  </div>
</section>

<style>
  .exp-card {
    padding: 20px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    transition: all 0.25s ease;
  }
  .exp-card:hover {
    background: #1e293b;
    border-color: rgba(100,255,218,0.1);
    box-shadow: 0 8px 32px rgba(2,12,27,0.5);
    transform: translateY(-2px);
  }
</style>