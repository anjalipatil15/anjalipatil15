---
import ProjectCard from './ProjectCard.astro'

const { projects } = Astro.props
const FEATURED = 3
const featured = projects.slice(0, FEATURED)
const more = projects.slice(FEATURED)
---

<section id="projects" class="section" aria-labelledby="projects-heading">
  <p class="section-label" id="projects-heading">Projects</p>

  <div class="space-y-3">
    {featured.map((p: any) => <ProjectCard p={p} />)}
  </div>

  {more.length > 0 && (
    <details class="more-projects">
      <summary class="more-btn">
        <span class="label-closed">+ {more.length} more project{more.length > 1 ? 's' : ''}</span>
        <span class="label-open">− Show fewer</span>
      </summary>
      <div class="space-y-3 mt-3">
        {more.map((p: any) => <ProjectCard p={p} />)}
      </div>
    </details>
  )}
</section>

<style>
  .more-projects {
    display: flex;
    flex-direction: column;
  }

  .more-btn {
    list-style: none;
    cursor: pointer;
    align-self: flex-start;
    margin: 12px 0 0 20px;
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    color: #64ffda;
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid rgba(100, 255, 218, 0.25);
    background: rgba(100, 255, 218, 0.05);
    transition: all 0.2s ease;
  }
  .more-btn::-webkit-details-marker { display: none; }
  .more-btn:hover {
    background: rgba(100, 255, 218, 0.12);
    border-color: rgba(100, 255, 218, 0.5);
  }

  .label-open { display: none; }
  .more-projects[open] .label-open { display: inline; }
  .more-projects[open] .label-closed { display: none; }

  @media (max-width: 600px) {
    .more-btn { margin-left: 0; }
  }
</style>
