---
const { personal } = Astro.props
---

<section
  id="hero"
  class="grid-bg relative min-h-screen flex flex-col justify-center px-6 pt-16 pb-24"
  aria-label="Introduction"
>
  <!-- Corner metadata (desktop only) -->
  <span class="absolute top-16 left-6 font-mono text-[10px] text-slate-700 tracking-widest hidden lg:block select-none">
    PORTFOLIO // 2025
  </span>
  <span class="absolute top-16 right-6 font-mono text-[10px] text-slate-700 tracking-widest hidden lg:block select-none">
    MUMBAI, IN
  </span>

  <!-- Ambient glow -->
  <div
    class="absolute inset-0 pointer-events-none overflow-hidden"
    aria-hidden="true"
  >
    <div style="position:absolute;top:45%;left:50%;transform:translate(-50%,-50%);width:600px;height:600px;background:radial-gradient(circle,rgba(6,182,212,0.055) 0%,transparent 68%);"></div>
  </div>

  <!-- Main content -->
  <div class="max-w-5xl mx-auto w-full">

    <!-- Live badge -->
    <div class="inline-flex items-center gap-2 border border-cyan-900/60 bg-cyan-950/20 rounded-md px-3 py-1.5 mb-8">
      <span class="pulse-dot"></span>
      <span class="font-mono text-[11px] text-cyan-400 tracking-widest uppercase">
        Open to Internships · Mumbai, India
      </span>
    </div>

    <!-- Name -->
    <h1
      class="font-display font-extrabold text-slate-50 leading-none tracking-tight"
      style="font-size:clamp(3rem,10vw,5.5rem);"
    >
      {personal.name.split(' ')[0]}<span class="text-cyan-400"> {personal.name.split(' ')[1]}</span>
    </h1>

    <!-- Title -->
    <p class="font-mono text-slate-500 text-xs sm:text-sm tracking-widest uppercase mt-5 mb-5">
      {personal.title}
    </p>

    <!-- Role statement -->
    <p class="text-slate-300 text-lg sm:text-xl leading-relaxed max-w-2xl font-light">
      {personal.roleStatement}
    </p>

    <!-- Interest tags -->
    <div class="flex flex-wrap gap-2 mt-7">
      {['Cybersecurity', 'OSINT', 'Digital Forensics', 'AI / ML', 'Threat Intelligence'].map(tag => (
        <span class="tag">{tag}</span>
      ))}
    </div>

    <!-- Links -->
    <div class="flex flex-wrap items-center gap-5 mt-10 pt-8 border-t border-[#1e2533]">
      <a href={`mailto:${personal.email}`} class="link-arrow">
        {personal.email}
      </a>
      <a href={personal.github} target="_blank" rel="noopener noreferrer" class="link-arrow">
        GitHub
      </a>
      <a href={personal.linkedin} target="_blank" rel="noopener noreferrer" class="link-arrow">
        LinkedIn
      </a>
      <a href={personal.medium} target="_blank" rel="noopener noreferrer" class="link-arrow">
        Medium
      </a>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 animate-bounce opacity-30 select-none" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-500"><polyline points="6 9 12 15 18 9"/></svg>
  </div>
</section>
