---
import SectionHeader from './SectionHeader.astro'
const { personal, certifications } = Astro.props
---

<section id="about" class="section" aria-labelledby="about-heading">
  <div class="max-w-5xl mx-auto px-6">
    <SectionHeader label="Who I Am" heading="About" />

    <div class="grid md:grid-cols-5 gap-10">

      <!-- Left: intro text -->
      <div class="md:col-span-3 space-y-4">
        <p class="text-slate-300 leading-relaxed text-[15px]">
          I'm a Computer Engineering student at NMIMS Mumbai with a focus on cybersecurity,
          OSINT, and practical systems. I'm interested in how attackers think, how
          defenses fail, and how machine learning can sharpen both detection and analysis.
        </p>
        <p class="text-slate-400 leading-relaxed text-[15px]">
          {personal.roleStatement}
        </p>
        <p class="text-slate-400 leading-relaxed text-[15px]">
          Outside coursework, I work on threat intelligence pipelines, practice on Hack The Box,
          and write about what I'm learning on Medium. I'm currently exploring digital forensics,
          OSINT workflows, and adversarial ML in intrusion detection.
        </p>

        <!-- Quick links -->
        <div class="flex flex-wrap gap-3 pt-2">
          <a href={personal.github}   target="_blank" rel="noopener noreferrer" class="link-arrow">GitHub</a>
          <a href={personal.linkedin} target="_blank" rel="noopener noreferrer" class="link-arrow">LinkedIn</a>
          <a href={personal.medium}   target="_blank" rel="noopener noreferrer" class="link-arrow">Medium</a>
          <a href={`mailto:${personal.email}`} class="link-arrow">{personal.email}</a>
        </div>
      </div>

      <!-- Right: certifications -->
      <div class="md:col-span-2">
        <p class="font-mono text-[11px] text-slate-500 tracking-widest uppercase mb-4">Certifications</p>
        <div class="space-y-3">
          {certifications.map((cert: { name: string; issuer: string; focus: string }) => (
            <div class="ap-card p-4">
              <p class="text-slate-200 text-sm font-medium">{cert.name}</p>
              <p class="font-mono text-[11px] text-cyan-700 mt-1">{cert.issuer}</p>
              <p class="text-slate-500 text-xs mt-1.5 leading-relaxed">{cert.focus}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
