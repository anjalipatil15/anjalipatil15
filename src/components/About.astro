---
const { personal, certifications } = Astro.props
---

<section id="about" class="section" aria-labelledby="about-heading">
  <p class="section-label" id="about-heading">About</p>

  <div class="space-y-4 mb-10">
    <p class="text-sm leading-relaxed" style="color:#a8b2d8;">
      I'm a Computer Engineering student at <span style="color:#64ffda;">NMIMS Mumbai</span>, working across cybersecurity, networking, OSINT, and Artificial Intelligence. 
      I’m interested in how systems behave, break, and can be made more reliable, from networks and security workflows to intelligent models and investigative tools.
    </p>
    <p class="text-sm leading-relaxed" style="color:#8892b0;">
      {personal.roleStatement}
    </p>
  </div>

  <!-- Certifications -->
  <p class="font-mono text-xs tracking-widest uppercase mb-4" style="color:#64ffda; opacity:0.6;">
    Certifications
  </p>
  <div class="space-y-3">
    {certifications.map((cert: { name: string; issuer: string; focus: string }) => (
      <div class="card p-4 flex items-start gap-4">
        <div class="flex-shrink-0 mt-0.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64ffda" stroke-width="2" stroke-linecap="round" opacity="0.7"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div>
          <p class="text-sm font-medium" style="color:#ccd6f6;">{cert.name}</p>
          <p class="font-mono text-xs mt-0.5" style="color:#64ffda; opacity:0.6;">{cert.issuer}</p>
          <p class="text-xs mt-1 leading-relaxed" style="color:#8892b0;">{cert.focus}</p>
        </div>
      </div>
    ))}
  </div>
</section>
