---
const { skills } = Astro.props
---

<section id="skills" class="section" aria-labelledby="skills-heading">
  <p class="section-label" id="skills-heading">Skills</p>

  <div class="skills-list">
    {skills.map((group: { category: string; items: string[] }) => (
      <div class="skill-row">
        <p class="font-mono text-xs tracking-wider uppercase pt-1" style="color:#8892b0;">
          {group.category}
        </p>
        <div class="flex flex-wrap gap-1.5">
          {group.items.map((item: string) => (
            <span class="tag">{item}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 0 20px;
  }
  .skill-row {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 16px;
    align-items: start;
  }

  @media (max-width: 600px) {
    .skills-list { padding: 0; gap: 16px; }
    .skill-row { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
